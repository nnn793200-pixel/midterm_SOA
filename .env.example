# ============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG (iBANKING TUITION PAYMENT - TDTU SOA MIDTERM)
# ============================================================================

# --- JWT & Bảo mật chung ---
JWT_SECRET_KEY=tdtu-soa-2026-super-secret-jwt-key-9999
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- PostgreSQL (4 Databases trên cùng 1 PostgreSQL Cluster) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

ACCOUNT_DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/account_db
TUITION_DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/tuition_db
PAYMENT_DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/payment_db
NOTIFICATION_DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/notification_db

# --- Redis (OTP TTL 300s, Lua One-Time Verify, Distributed Lock) ---
REDIS_URL=redis://redis:6379/0
OTP_TTL_SECONDS=300

# --- Mailpit SMTP Server ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=ibanking-noreply@tdtu.edu.vn
SMTP_FROM_NAME=TDTU iBanking System

# --- Internal Microservice Endpoints ---
AUTH_ACCOUNT_SERVICE_URL=http://auth-account-service:8001
TUITION_SERVICE_URL=http://tuition-service:8002
PAYMENT_SERVICE_URL=http://payment-service:8003
NOTIFICATION_OTP_SERVICE_URL=http://notification-otp-service:8004
